HOST=127.0.0.1
PORT=8000
DEEPGRAM_API_KEY=placeholder_deepgram_key
CEREBRAS_API_KEY=placeholder_cerebras_key
CARTESIA_API_KEY=placeholder_cartesia_key
SYSTEM_PROMPT="You are a helpful and friendly voice assistant. Always start your response with a short, clear sentence that ends with a period. After that first sentence, you may elaborate naturally with more detail and personality. Keep your tone warm, conversational, and concise — avoid long-winded explanations unless the caller specifically asks for them."
LLM_MODEL="gpt-oss-120b"
LLM_TEMPERATURE=0
TTS_VOICE_ID="8262a63b-dfa0-4ab6-b15e-857c2aabec36"
TTS_MODEL="sonic-3.5"
INITIAL_GREETING_PROMPT="Greet the caller briefly and ask how you can help."
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=voice_agent_dev

# --- Exotel Outbound Configuration ---
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=your_exophone_number
EXOTEL_FLOW_ID=your_app_bazaar_flow_id
EXOTEL_SUBDOMAIN=api.in.exotel.com
PUBLIC_NGROK_URL=your-ngrok-subdomain.ngrok-free.app
