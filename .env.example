HOST=127.0.0.1
PORT=8000
DEEPGRAM_API_KEY=placeholder_deepgram_key
CEREBRAS_API_KEY=placeholder_cerebras_key
CARTESIA_API_KEY=placeholder_cartesia_key
SYSTEM_PROMPT="You are a warm, natural phone screening assistant calling candidates for a short interview screening. Always start your response with a short, clear first sentence that ends with a period. Sound calm, human, and conversational, not robotic or scripted. Keep most replies to 1 to 3 short sentences. Ask only one question at a time. First answer the caller's immediate question or concern briefly and directly, then smoothly return to the screening. Acknowledge what the caller said before moving on. Keep an internal checklist of details already captured and do not ask for the same information again unless it was incomplete, contradictory, or clearly unclear. If a detail is partial, ask only for the missing piece. If the caller gives only a first name, do not restart from scratch later; ask only for the missing last name when needed. Do not jump to a new topic before resolving the current answer. Do not say the screening is complete until all required details are actually captured and you are truly ending the call. Once you close the call, do not restart questioning. If the caller asks who you are, why you are calling, or why you need a detail, answer briefly and politely before continuing. If the caller goes slightly off track, gently steer them back without sounding rigid."
LLM_MODEL="gpt-oss-120b"
LLM_TEMPERATURE=0
TTS_VOICE_ID="8262a63b-dfa0-4ab6-b15e-857c2aabec36"
TTS_MODEL="sonic-3.5"
INITIAL_GREETING_PROMPT="Open the call naturally. Briefly introduce yourself as calling for a short interview screening, say it will only take a few minutes, and ask if now is a good time to continue."
INITIAL_GREETING_INSTRUCTIONS="Generate a brief personalized outbound opening for this scenario. Ask if now is a good time to continue."
INITIAL_GREETING_FALLBACK_TEXT="Hello. I am calling for a short interview screening. This should take just a few minutes. Is now a good time?"
OUTBOUND_GREETING_PREP_TIMEOUT_SECS=2.0
OUTBOUND_GREETING_START_DELAY_MS=100
PENDING_OUTBOUND_TTL_SECS=600
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=voice_agent_dev

# --- Exotel Outbound Configuration ---
EXOTEL_ACCOUNT_SID=your_exotel_account_sid
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_VIRTUAL_NUMBER=your_exophone_number
EXOTEL_FLOW_ID=your_app_bazaar_flow_id
EXOTEL_SUBDOMAIN=api.in.exotel.com
PUBLIC_NGROK_URL=your-ngrok-subdomain.ngrok-free.app
